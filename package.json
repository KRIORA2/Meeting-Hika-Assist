{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/hika run dev",
    "dev:web": "pnpm --filter @workspace/hika run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:desktop": "pnpm --filter @workspace/hika-desktop run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build --force",
    "verify:realtime": "node scripts/verify-realtime-security.mjs",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "verify:answers": "pnpm --filter @workspace/scripts exec tsx src/verify-answer-quality.ts"
  },
  "private": true,
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "^25.1.8",
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@esbuild/win32-x64": "0.27.3"
  }
}
