# ==========================================
# Hika Meeting Assistant Environment Variables
# ==========================================

# Application
NODE_ENV=development
PORT=5000
# Comma-separated browser origins permitted to call the API in production.
CORS_ALLOWED_ORIGINS=https://your-web-app.example.com

# Frontend (set this in Vercel at build time)
VITE_API_URL=https://your-render-api.onrender.com
# Used by the packaged desktop app for sign-in and dashboard links.
HIKA_WEB_APP_URL=https://your-web-app.example.com
# Optional desktop API override; packaged builds otherwise use the production default.
HIKA_API_URL=https://your-render-api.onrender.com

# PostgreSQL is no longer used. Hikanest stores accounts, sessions, insights,
# and documents in Firebase.
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Firebase web app (Vercel / Vite)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Firebase Admin (API server). Prefer a single JSON secret in production.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1
# Models selectable by clients; all other requested model names are rejected.
OPENAI_ALLOWED_MODELS=gpt-4.1,gpt-4o
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key
# Used by the low-latency WebRTC voice path. Leave unset to use gpt-realtime.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_NOISE_REDUCTION=near_field
OPENAI_REALTIME_CLIENT_SECRET_TTL_SECONDS=600
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=220
OPENAI_REALTIME_VAD_THRESHOLD=0.45
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=200
# Low-latency interview turns vs. more natural meeting pauses.
INTERVIEW_VAD_SILENCE_MS=900
MEETING_VAD_SILENCE_MS=1000

# Desktop update manifest (set in the API service when publishing a new installer)
DESKTOP_LATEST_VERSION=1.1.0
DESKTOP_DOWNLOAD_URL=https://github.com/KRIORA2/Meeting-Hika-Assist/releases/latest/download/Hikanest-Setup.exe

# Google Login: Vercel and Render must use the same Web OAuth client ID.
# GOOGLE_CLIENT_IDS is a comma-separated backend allowlist for additional IDs.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_IDS=your-google-oauth-client-id
HIKA_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Stripe (optional — Pricing page works without these; checkout enables when set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_SESSION=

# Session
SESSION_SECRET=your-secure-session-secret
