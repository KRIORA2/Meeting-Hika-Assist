# ==========================================
# Hika Meeting Assistant Environment Variables
# ==========================================

# Application
NODE_ENV=development
PORT=3000
# Comma-separated browser origins permitted to call the API in production.
CORS_ALLOWED_ORIGINS=https://your-web-app.example.com

# Frontend (set this in Vercel at build time)
VITE_API_URL=https://your-render-api.onrender.com

# PostgreSQL Database
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# OpenAI
OPENAI_API_KEY=your-openai-api-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key
# Used by the low-latency WebRTC voice path. Leave unset to use gpt-realtime.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_NOISE_REDUCTION=near_field
OPENAI_REALTIME_CLIENT_SECRET_TTL_SECONDS=600
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=220
OPENAI_REALTIME_VAD_THRESHOLD=0.45
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=200
# Low-latency interview turns vs. more natural meeting pauses.
INTERVIEW_VAD_SILENCE_MS=250
MEETING_VAD_SILENCE_MS=400

# Desktop update manifest (set in the API service when publishing a new installer)
DESKTOP_LATEST_VERSION=1.0.0
DESKTOP_DOWNLOAD_URL=https://your-web-app.example.com/downloads/windows/Hikanest-Setup.exe

# Google Login: Vercel and Render must use the same Web OAuth client ID.
# GOOGLE_CLIENT_IDS is a comma-separated backend allowlist for additional IDs.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_IDS=your-google-oauth-client-id
HIKA_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Session
SESSION_SECRET=your-secure-session-secret
